    "BlockSpec": {
      "additionalProperties": false,
      "description": "一顆積木的宣告。`opcode` 是**不帶命名空間**的短名。",
      "properties": {
        "opcode": {
          "title": "Opcode",
          "type": "string"
        },
        "type": {
          "enum": [
            "command",
            "reporter",
            "boolean",
            "hat"
