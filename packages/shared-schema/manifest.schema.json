        "default": {
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "key"
      ],
      "title": "ConfigSpec",
      "type": "object"
    },
    "OptionSpec": {
      "additionalProperties": false,
      "description": "靜態下拉的一個選項（內建積木用）。\n\n積木包的下拉是**動態**的（`source` 指向 `@dropdown` 函式），因為選項來自\n外部服務；內建積木的下拉是**固定**的（`unit` 只有那六個），選項就是宣告的\n一部分，沒有人可以去問。",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "value"
      ],
      "title": "OptionSpec",
      "type": "object"
    },
    "YieldSpec": {
      "additionalProperties": false,
      "description": "hat 綁進 thread-local 的變數（§5.4 第 2 層，唯讀）。",
